# Kopiere diese Datei zu .env.local und fülle die Werte aus

# --- Kontaktformular (SMTP via All-Inkl) ---
# SMTP-Servername aus KAS → E-Mail-Adressen → Postfach (z.B. w01234ab.kasserver.com)
SMTP_HOST=w0xxxx.kasserver.com
SMTP_PORT=587
SMTP_USER=kontakt@traumplatz-gartenpflege.de
SMTP_PASS=

# E-Mail-Adresse, an die Kontaktanfragen gesendet werden
CONTACT_EMAIL=kontakt@traumplatz-gartenpflege.de

# --- Google Places API ---
# Erstellen unter: https://console.cloud.google.com/apis/credentials
GOOGLE_PLACES_API_KEY=

# Google Place ID für Traumplatz
# Finden unter: https://developers.google.com/maps/documentation/javascript/examples/places-placeid-finder
# Suche: "Traumplatz, Berliner Ring 89, 64625 Bensheim"
GOOGLE_PLACE_ID=
